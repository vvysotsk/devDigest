# Force LF line endings for scripts and text files, regardless of OS.
* text=auto eol=lf

*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files should never be touched
*.png binary
*.jpg binary
*.ico binary
